{
  "attributes": {
    "name": {
      "type": "String",
      "required": true
    },
    "description": {
      "type": "String"
    },
    "images": [
      {
        "type": "ObjectId",
        "ref": "Upload"
      }
    ],
    "categories": [
      {
        "type": "ObjectId",
        "ref": "Category"
      }
    ],
    "country": {
      "type": "String"
    },
    "address": {
      "line1": {
        "type": "String"
      },
      "line2": {
        "type": "String"
      },
      "city": {
        "type": "String"
      },
      "postalCode": {
        "type": "String"
      },
      "region": {
        "type": "String"
      },
      "countryCode": {
        "type": "String"
      },
      "geometry": {
        "type": {
          "type": "String",
          "default": "Point"
        },
        "coordinates": [
          "Number",
          "Number"
        ]
      }
    },
    "user": {
      "type": "ObjectId",
      "ref": "User"
    }
  },
  "onDelete": {
    "errorOnReferenced": {
      "except": [
        "AuditEntry"
      ]
    }
  },
  "access": {
    "update": [
      "user",
      "admin",
      "superAdmin"
    ],
    "delete": [
      "user",
      "admin",
      "superAdmin"
    ]
  },
  "search": {
    "fields": [
      "name"
    ]
  }
}
