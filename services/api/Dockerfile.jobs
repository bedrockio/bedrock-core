FROM node:26.3.0-alpine

# Production builds omit devDependencies via --prod on the install below (pnpm
# ignores NODE_ENV for this). docker-compose overrides this ARG to "development"
# to install them. NODE_ENV is also exported for the running app.
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

# Note layers should be ordered from less to more likely to change.

# Enable community & install Python + pipx + yq
RUN echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/community" \
      >> /etc/apk/repositories && \
    apk add --no-cache \
      bash \
      curl \
      gcc \
      jq \
      musl-dev \
      python3 \
      py3-pip \
      pipx

RUN pip install --break-system-packages yacron

# Download Mike Farah’s yq
ARG YQ_VERSION=v4.44.5
ARG YQ_BINARY=yq_linux_amd64
RUN wget -qO /usr/local/bin/yq \
      https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/${YQ_BINARY} \
    && chmod +x /usr/local/bin/yq

# Needed for Gcloud Storage resumable file uploads
RUN mkdir -p /root/.config

# Install pnpm (Node 26 no longer bundles corepack)
RUN npm install -g pnpm@11.5.2

# Set work directory
WORKDIR /service

# Install dependencies and store pnpm cache
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile $([ "$NODE_ENV" = production ] && echo --prod)

# Copy app source
COPY . .

CMD ["python3", "./scripts/entrypoints/jobs.py", "jobs/default.yml"]